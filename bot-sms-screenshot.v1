const express = require("express");
const { google } = require("googleapis");
const { execSync } = require("child_process");
const notifier = require("node-notifier");
const fs = require("fs");
const path = require("path");

// ================= CONFIG =================
const SPREADSHEET_ID = "1MlYstlcJdUurTSthIabeWdpjVwOgDdN8B3cWQso1H78";
const SHEET_NAME = "Sheet1";
let CONFIG = { 
  delay: 5000, 
  retry: 2, 
  adbPath: "C:\\Users\\herua\\Documents\\bot-sms\\platform-tools\\adb.exe" 
};
// ==========================================

const app = express();
const PORT = 3000;
app.use(express.json());

// ================= STATE =================
let logs = [];
let isRunning = false;
let stopRequested = false;
let progress = 0;
let total = 0;
let done = 0;
let failed = 0;
let lastImages = [];
let sheetData = [];
let deviceInfo = { name: "Unknown", serial: "", android: "", usbDebug: false };

// ================= LOG =================
function addLog(msg, type) {
  const time = new Date().toLocaleTimeString("id-ID", { hour12: false });
  if (!type) {
    if (msg.includes("❌") || msg.includes("FAILED")) type = "error";
    else if (msg.includes("⚠️") || msg.includes("Retry") || msg.includes("retry")) type = "warn";
    else if (msg.includes("✅") || msg.includes("DONE") || msg.includes("📸") || msg.includes("berhasil")) type = "ok";
    else if (msg.includes("🚀") || msg.includes("🎉") || msg.includes("📊") || msg.includes("ℹ")) type = "info";
    else type = "log";
  }
  const log = { text: msg, time, type };
  console.log("[" + time + "] " + msg);
  logs.push(log);
  if (logs.length > 500) logs.shift();
}

// ================= FOLDER =================
const SCREENSHOT_DIR = path.join(__dirname, "screenshots");
if (!fs.existsSync(SCREENSHOT_DIR)) fs.mkdirSync(SCREENSHOT_DIR);
app.use("/screenshots", express.static(SCREENSHOT_DIR));

// ================= GOOGLE =================
const auth = new google.auth.GoogleAuth({
  keyFile: "credentials.json",
  scopes: ["https://www.googleapis.com/auth/spreadsheets"],
});

// ================= UTIL =================
function sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }
function safeName(t) { return t.trim().replace(/[\\/:*?"<>|]/g, ""); }

// ================= DEVICE =================
function checkDevice() {
  try {
    const out = execSync('"' + CONFIG.adbPath + '" devices').toString();
    return out.includes("device");
  } catch (e) { return false; }
}

function getDeviceInfo() {
  try {
    const model  = execSync('"' + CONFIG.adbPath + '" shell getprop ro.product.model').toString().trim();
    const serial = execSync('"' + CONFIG.adbPath + '" shell getprop ro.serialno').toString().trim();
    const ver    = execSync('"' + CONFIG.adbPath + '" shell getprop ro.build.version.release').toString().trim();
    deviceInfo = { name: model, serial, android: ver, usbDebug: true };
  } catch (e) {
    deviceInfo = { name: "Unknown", serial: "", android: "", usbDebug: false };
  }
}

app.get("/device-status", (req, res) => {
  try {
    const out = execSync('"' + CONFIG.adbPath + '" devices').toString();
    const lines = out.split("\n").filter(l => l.trim() && !l.includes("List"));
    const devices = lines.filter(l => l.includes("device"));
    if (devices.length > 0) getDeviceInfo();
    res.json({ connected: devices.length > 0, count: devices.length, info: deviceInfo });
  } catch (e) {
    res.json({ connected: false, count: 0, info: deviceInfo });
  }
});

// ================= SHEET =================
async function getData() {
  addLog("📄 Membaca Google Sheets...", "info");
  const client = await auth.getClient();
  const sheets = google.sheets({ version: "v4", auth: client });
  const res = await sheets.spreadsheets.values.get({
    spreadsheetId: SPREADSHEET_ID,
    range: SHEET_NAME + "!A2:C",
  });
  sheetData = res.data.values || [];
  addLog("✅ " + sheetData.length + " kontak dimuat", "ok");
  return sheetData;
}

async function updateStatus(row, status) {
  const client = await auth.getClient();
  const sheets = google.sheets({ version: "v4", auth: client });
  await sheets.spreadsheets.values.update({
    spreadsheetId: SPREADSHEET_ID,
    range: SHEET_NAME + "!C" + row,
    valueInputOption: "RAW",
    requestBody: { values: [[status]] },
  });
  if (sheetData[row - 2]) sheetData[row - 2][2] = status;
}

app.get("/sheet-data",    (req, res) => res.json({ rows: sheetData, sheet: SHEET_NAME }));
app.get("/refresh-sheet", async (req, res) => {
  try { await getData(); res.json({ ok: true, count: sheetData.length }); }
  catch (e) { res.json({ ok: false, error: e.message }); }
});

// ================= SCREENSHOT =================
async function screenshotSMS(nomor, nama, rowIndex) {
  let attempt = 0;
  while (attempt <= CONFIG.retry) {
    try {
      addLog("📱 Membuka SMS: " + nama + " (" + nomor + ")", "log");
      execSync('"' + CONFIG.adbPath + '" shell am start -a android.intent.action.VIEW -d sms:' + nomor);
      await sleep(4000);
      const fileName = safeName(nama) + ".png";
      const filePath = path.join(SCREENSHOT_DIR, fileName);
      execSync('"' + CONFIG.adbPath + '" exec-out screencap -p > "' + filePath + '"', { shell: true });
      const stat = fs.statSync(filePath);
      const imgPath = "/screenshots/" + fileName;
      lastImages.unshift({
        src: imgPath, name: nama, nomor: nomor,
        time: new Date().toLocaleTimeString("id-ID", { hour12: false }),
        size: (stat.size / 1024).toFixed(1) + " KB"
      });
      if (lastImages.length > 20) lastImages.pop();
      addLog("📸 Screenshot berhasil: " + fileName, "ok");
      await updateStatus(rowIndex, "DONE");
      done++;
      progress = Math.floor((done / total) * 100);
      return;
    } catch (e) {
      attempt++;
      addLog("⚠️ Gagal, retry " + attempt + "/" + CONFIG.retry + ": " + nama, "warn");
      if (attempt > CONFIG.retry) {
        await updateStatus(rowIndex, "FAILED");
        failed++;
        addLog("❌ GAGAL (maks retry): " + nama, "error");
      }
    }
  }
}

// ================= MAIN =================
async function processAll() {
  if (isRunning) return;
  isRunning = true;
  stopRequested = false;
  done = 0; failed = 0; progress = 0;
  addLog("🚀 Proses dimulai", "info");
  try {
    const data = await getData();
    const pending = data.filter(d => !d[2] || d[2] === "" || d[2] === "READY");
    total = pending.length;
    addLog("📊 " + total + " kontak akan diproses", "info");
    for (let i = 0; i < data.length; i++) {
      if (stopRequested) { addLog("⏹ Dihentikan oleh pengguna", "warn"); break; }
      const [nama, nomor, status] = data[i];
      if (!nama || !nomor) continue;
      if (!status || status === "" || status === "READY") {
        await screenshotSMS(nomor, nama, i + 2);
        await sleep(CONFIG.delay);
      }
    }
  } catch (e) { addLog("❌ Error: " + e.message, "error"); }
  isRunning = false;
  notifier.notify({ title: "Bot SMS Selesai", message: done + " berhasil, " + failed + " gagal" });
  addLog("🎉 Selesai — " + done + " berhasil, " + failed + " gagal", "ok");
}

// ================= API =================
app.get("/start",  (req, res) => {
  if (!checkDevice()) return res.json({ ok: false, msg: "Device tidak terdeteksi" });
  lastImages = []; 
  processAll();
  res.json({ ok: true });
});
app.get("/stop",   (req, res) => { stopRequested = true; res.json({ ok: true }); });
app.get("/logs",   (req, res) => res.json(logs));
app.get("/status", (req, res) => {
  const doneC = sheetData.filter(r => r[2] === 'DONE').length;
  const failC = sheetData.filter(r => r[2] === 'FAILED').length;
  const pendC = sheetData.filter(r => !r[2] || r[2] === '' || r[2] === 'READY').length;
  res.json({ progress, done, total, failed, running: isRunning, lastImages, counts: { total: sheetData.length, done: doneC, pending: pendC, failed: failC } });
});
app.post("/config", (req, res) => {
  const b = req.body || {};
  if (b.delay) CONFIG.delay = parseInt(b.delay) * 1000;
  if (b.retry) CONFIG.retry = parseInt(b.retry);
  if (b.adbPath) CONFIG.adbPath = b.adbPath;
  addLog("⚙ Konfigurasi disimpan", "info");
  res.json({ ok: true, config: CONFIG });
});
app.get("/config", (req, res) => res.json(CONFIG));

// ================= UI =================
app.get("/", (req, res) => {
  res.send(`<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Bot SMS — Command Center</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Exo+2:wght@300;400;500;600;700&family=Orbitron:wght@600;800&display=swap" rel="stylesheet">
<!-- LOTTIE PLAYER -->
<script src="https://unpkg.com/@dotlottie/player-component@latest/dist/dotlottie-player.mjs" type="module"></script>
<style>
:root{
  --bg:#0a0f1a; --bg2:#0d1525; --bg3:#111d30;
  --border:#1e2d45; --border2:#243550;
  --cyan:#00d4ff; --green:#00e676; --red:#ff3d57; --amber:#ffab00; --purple:#7c4dff;
  --text:#e8edf8; --text2:#b0c4de; --text3:#7a90b0;
  --mono:'Share Tech Mono',monospace; --body:'Exo 2',sans-serif; --orb:'Orbitron',monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text);font-family:var(--body);min-height:100vh;position:relative;}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse 80% 50% at 50% -10%,rgba(0,212,255,.07),transparent);pointer-events:none;z-index:0;}
::-webkit-scrollbar{width:5px;height:5px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px;}

.wrap{position:relative;z-index:1;max-width:1600px;margin:0 auto;padding:0 24px 40px;}

/* HERO */
.hero{display:flex;align-items:center;justify-content:space-between;padding:16px 0 14px;position:relative;}
.hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);}
.hero-left{display:flex;align-items:center;gap:14px;flex:1;}
.hero-adb-info{display:flex;flex-direction:column;gap:2px;}
.hero-adb-label{font-family:var(--orb);font-size:10px;color:var(--cyan);letter-spacing:1px;}
.hero-adb-port{font-family:var(--mono);font-size:10px;color:var(--text3);}

/* HERO ICON LOTTIE */
.hero-adb-icon{width:50px;height:50px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}

.hero-divider{width:1px;height:36px;background:var(--border2);}
.hero-center{text-align:center;flex:1.5;}
.hero-title{font-family:var(--orb);font-size:30px;font-weight:800;color:var(--cyan);letter-spacing:6px;text-shadow:0 0 30px rgba(0,212,255,.5),0 0 60px rgba(0,212,255,.2);animation:tglow 3s ease-in-out infinite;}
@keyframes tglow{0%,100%{text-shadow:0 0 20px rgba(0,212,255,.4),0 0 50px rgba(0,212,255,.15);}50%{text-shadow:0 0 35px rgba(0,212,255,.7),0 0 80px rgba(0,212,255,.3);}}
.hero-dot{width:7px;height:7px;border-radius:50%;background:var(--cyan);margin:6px auto 4px;box-shadow:0 0 10px var(--cyan);animation:blink 2s ease-in-out infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
.hero-right{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex:1;}
.hero-device-badge{font-family:var(--mono);font-size:11px;padding:6px 14px;border-radius:6px;border:1px solid var(--green);color:var(--green);display:flex;align-items:center;gap:8px;background:rgba(0,230,118,.05);}
.hero-device-badge.off{border-color:var(--red);color:var(--red);background:rgba(255,61,87,.05);}

/* ADB PANEL */
.adb-panel{background:var(--bg2);border:1px solid var(--border);border-radius:10px;margin-top:14px;overflow:hidden;}
.adb-body{display:flex;align-items:center;padding:15px 24px;gap:0;}

/* DEVICE ICON LOTTIE */
.dev-icon{width:70px;height:70px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-right:16px;}

.dev-info{flex:1;}
.dev-name{font-weight:600;font-size:14px;color:var(--text);}
.dev-serial{font-family:var(--mono);font-size:10px;color:var(--text3);margin-top:2px;}
.dev-tags{display:flex;gap:6px;margin-top:6px;flex-wrap:wrap;}
.tag{font-size:10px;padding:2px 8px;border-radius:3px;font-family:var(--mono);}
.tg{background:rgba(0,230,118,.1);color:var(--green);border:1px solid rgba(0,230,118,.3);}
.tc{background:rgba(0,212,255,.1);color:var(--cyan);border:1px solid rgba(0,212,255,.3);}
.ta{background:rgba(255,171,0,.1);color:var(--amber);border:1px solid rgba(255,171,0,.3);}

.adb-actions{flex:1;display:flex;justify-content:center;align-items:center;gap:12px;padding:0 30px;border-left:1px solid var(--border);border-right:1px solid var(--border);height:60px;}
.btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--body);font-size:13px;font-weight:600;padding:10px 22px;border-radius:6px;border:1px solid;cursor:pointer;transition:all .2s;background:transparent;letter-spacing:.5px;white-space:nowrap;}
.btn:active{transform:scale(.97);}
.btn-start{color:var(--green);border-color:var(--green);background:rgba(0,230,118,.08);}
.btn-start:hover{background:rgba(0,230,118,.18);box-shadow:0 0 16px rgba(0,230,118,.3);}
.btn-stop{color:var(--amber);border-color:var(--amber);background:rgba(255,171,0,.08);}
.btn-stop:hover{background:rgba(255,171,0,.18);box-shadow:0 0 16px rgba(255,171,0,.3);}

.prog-sec{flex:1;padding-left:30px;min-width:250px;}
.prog-lbl{font-size:10px;color:var(--text2);letter-spacing:2px;text-transform:uppercase;margin-bottom:6px;}
.prog-nums{font-family:var(--orb);font-size:22px;color:var(--cyan);}
.prog-sub{font-size:11px;color:var(--text3);margin-top:1px;}
.prog-bar{height:5px;background:rgba(0,212,255,.1);border-radius:3px;overflow:hidden;margin-top:8px;}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--cyan),rgba(0,212,255,.6));border-radius:3px;transition:width .6s;box-shadow:0 0 8px rgba(0,212,255,.5);width:0%;}

/* STAT CARDS */
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:14px;}
.sc{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:16px;position:relative;overflow:hidden;}
.sc::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
.sc.cc::before{background:var(--cyan);box-shadow:0 0 8px var(--cyan);}
.sc.cg::before{background:var(--green);box-shadow:0 0 8px var(--green);}
.sc.ca::before{background:var(--amber);box-shadow:0 0 8px var(--amber);}
.sc.cr::before{background:var(--red);box-shadow:0 0 8px var(--red);}
.sc-lbl{font-size:10px;letter-spacing:2px;color:var(--text2);text-transform:uppercase;}
.sc-val{font-family:var(--orb);font-size:38px;font-weight:800;line-height:1;margin:8px 0 4px;}
.cc .sc-val{color:var(--cyan);text-shadow:0 0 20px rgba(0,212,255,.4);}
.cg .sc-val{color:var(--green);text-shadow:0 0 20px rgba(0,230,118,.4);}
.ca .sc-val{color:var(--amber);text-shadow:0 0 20px rgba(255,171,0,.4);}
.cr .sc-val{color:var(--red);text-shadow:0 0 20px rgba(255,61,87,.4);}
.sc-desc{font-size:11px;color:var(--text2);}
.sc-bg{position:absolute;right:12px;bottom:10px;font-size:44px;opacity:1;filter:drop-shadow(0 0 4px rgba(255,255,255,.2));}

.three-col{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:14px;margin-top:14px;}

.panel{background:var(--bg2);border:1px solid var(--border);border-radius:10px;overflow:hidden;display:flex;flex-direction:column;}
.ph{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--border);flex-shrink:0;}
.pt{font-family:var(--orb);font-size:10px;font-weight:600;letter-spacing:2px;text-transform:uppercase;display:flex;align-items:center;gap:8px;}
.pdot-lottie{width:18px;height:18px;display:inline-block;vertical-align:middle;}

.mb{font-family:var(--mono);font-size:10px;padding:3px 10px;border-radius:4px;border:1px solid;cursor:pointer;background:transparent;transition:all .15s;}
.mbc{color:var(--cyan);border-color:rgba(0,212,255,.4);}
.mba{color:var(--amber);border-color:rgba(255,171,0,.4);}
.ml{font-family:var(--mono);font-size:10px;color:var(--text3);}

.g-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;padding:10px;overflow-y:auto;max-height:600px;}
.g-item{position:relative;border-radius:6px;overflow:hidden;border:1px solid var(--border);cursor:pointer;background:var(--bg);transition:all .2s;}
.g-item:hover{border-color:var(--cyan);box-shadow:0 0 10px rgba(0,212,255,.2);}
.g-item img{width:100%;height:auto;display:block;}
.g-lbl{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(0,0,0,.9));padding:14px 4px 4px;font-size:8px;color:#ddd;font-family:var(--mono);text-align:center;line-height:1.4;}
.g-size{font-size:7px;color:var(--cyan);opacity:.9;}
.g-empty{grid-column:1/-1;text-align:center;padding:30px;color:var(--text3);font-size:12px;letter-spacing:1px;}

.mt-wrap{padding:0 14px 12px;overflow-y:auto;max-height:600px;}
.mt{width:100%;border-collapse:collapse;font-size:12px;}
.mt th{text-align:left;font-family:var(--mono);font-size:10px;color:var(--text2);letter-spacing:1px;padding:6px 8px;border-bottom:1px solid var(--border);font-weight:400;text-transform:uppercase;}
.mt td{padding:7px 8px;border-bottom:1px solid rgba(30,45,69,.5);color:var(--text);}
.mt tr:hover td{background:rgba(0,212,255,.03);}
.bd{background:rgba(0,230,118,.1);color:var(--green);border:1px solid rgba(0,230,118,.3);font-size:10px;padding:1px 8px;border-radius:3px;font-family:var(--mono);}

.cfg-body{padding:14px;display:flex;flex-direction:column;gap:10px;}
.cfg-grp{display:flex;flex-direction:column;gap:4px;}
.cfg-lbl{font-size:10px;color:var(--text2);letter-spacing:1px;text-transform:uppercase;}
.cfg-in{background:var(--bg);border:1px solid var(--border2);border-radius:5px;color:var(--text);font-family:var(--mono);font-size:12px;padding:7px 10px;width:100%;transition:border-color .2s;}
.cfg-in:focus{outline:none;border-color:var(--cyan);}
.cfg-pr{display:flex;gap:6px;}
.cfg-pr .cfg-in{flex:1;}
.bp{font-family:var(--mono);font-size:10px;padding:0 10px;background:rgba(0,212,255,.08);border:1px solid rgba(0,212,255,.3);color:var(--cyan);border-radius:5px;cursor:pointer;white-space:nowrap;transition:all .2s;}
.btn-save{font-family:var(--body);font-weight:600;font-size:13px;padding:9px;border-radius:6px;border:1px solid rgba(0,212,255,.4);cursor:pointer;background:linear-gradient(135deg,rgba(0,212,255,.2),rgba(124,77,255,.2));color:var(--cyan);text-align:center;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;}

.log-body{flex:1;overflow-y:auto;padding:8px 10px;font-family:var(--mono);font-size:11px;max-height:280px;min-height:200px;}
.le{display:flex;gap:8px;padding:2px 0;line-height:1.6;}
.lt{color:var(--text3);flex-shrink:0;}
.ltype{flex-shrink:0;font-size:10px;padding:0 5px;border-radius:2px;align-self:flex-start;margin-top:2px;}
.lok{background:rgba(0,230,118,.15);color:var(--green);}
.lwarn{background:rgba(255,171,0,.15);color:var(--amber);}
.lerr{background:rgba(255,61,87,.15);color:var(--red);}
.linf{background:rgba(0,212,255,.15);color:var(--cyan);}
.llog{background:rgba(255,255,255,.05);color:var(--text2);}
.lm{color:var(--text);flex:1;}
.le.latest .lm{color:var(--cyan);}

.footer{display:flex;align-items:flex-end;justify-content:space-between;padding:20px 0 8px;border-top:1px solid var(--border);margin-top:20px;}
.footer-gh{font-family:var(--mono);font-size:11px;color:var(--cyan);text-decoration:none;display:flex;align-items:center;gap:6px;}

@keyframes prog-stripe{0%{background-position:0 0;}100%{background-position:40px 0;}}
.prog-fill-active{background:repeating-linear-gradient(90deg,var(--cyan) 0px,rgba(0,212,255,.7) 10px,var(--cyan) 20px);background-size:40px 100%;animation:prog-stripe .6s linear infinite;}

#viewer{position:fixed;inset:0;background:rgba(5,8,15,.95);backdrop-filter:blur(10px);display:none;justify-content:center;align-items:center;z-index:999;}
#viewer.show{display:flex;}
.vbox{position:relative;}
#vImg{max-width:90vw;max-height:88vh;border-radius:8px;border:1px solid var(--border);}
.vcls{position:absolute;top:-12px;right:-12px;width:26px;height:26px;border-radius:50%;background:var(--red);border:none;cursor:pointer;font-size:13px;color:white;display:flex;align-items:center;justify-content:center;}
.vcap{text-align:center;margin-top:10px;font-family:var(--mono);font-size:11px;color:var(--text2);}

#filePickerInput{display:none;}
</style>
</head>
<body>
<div class="wrap">

<!-- HERO TOP BAR -->
<div class="hero">
  <div class="hero-left">
    <div class="hero-adb-icon">
      <dotlottie-player src="https://lottie.host/5155b7e5-348f-4085-b714-4e3f8d8bceb8/9PK8h6mWso.lottie" background="transparent" speed="1" style="width: 100%; height: 100%;" loop autoplay></dotlottie-player>
    </div>
    <div class="hero-adb-info">
      <div class="hero-adb-label">ADB Control Panel</div>
      <div class="hero-adb-port">port 3000 · v2.0</div>
    </div>
    <div class="hero-divider"></div>
    <div class="hero-adb-info">
      <div class="hero-adb-label" style="color:var(--text2);">PLN UP2D Banten</div>
      <div class="hero-adb-port">Bot Screenshot</div>
    </div>
  </div>

  <div class="hero-center">
    <div class="hero-title">COMMAND CENTER</div>
    <div class="hero-dot"></div>
  </div>

  <div class="hero-right">
    <div id="adbBadge" class="hero-device-badge off">Mengecek device...</div>
    <div id="devSerial" class="hero-adb-port" style="margin-top:4px;">Serial: Menunggu...</div>
  </div>
</div>

<!-- ADB PANEL -->
<div class="adb-panel">
  <div class="adb-body">
    <div class="dev-icon">
      <dotlottie-player src="https://lottie.host/5ddf37b9-94fd-441a-99aa-9e10b8284438/ZRy6NxXHva.lottie" background="transparent" speed="1" style="width: 100%; height: 100%;" loop autoplay></dotlottie-player>
    </div>
    <div class="dev-info">
      <div class="dev-name" id="devName">Menunggu device...</div>
      <div class="dev-tags" id="devTags">
        <span class="tag ta">Disconnected</span>
      </div>
    </div>

    <div class="adb-actions">
      <button class="btn btn-start" onclick="doStart()">▶ Mulai Screenshot</button>
      <button class="btn btn-stop"  onclick="doStop()">⏹ Stop</button>
    </div>

    <div class="prog-sec">
      <div class="prog-lbl">Progress Sesi Ini</div>
      <div class="prog-nums"><span id="pDone">0</span> / <span id="pTotal">0</span></div>
      <div class="prog-sub">screenshot diambil</div>
      <div class="prog-bar"><div id="progFill" class="prog-fill"></div></div>
    </div>
  </div>
</div>

<!-- STAT CARDS -->
<div class="stat-grid">
  <div class="sc cc">
    <div class="sc-lbl">Total Kontak</div>
    <div class="sc-val" id="stTotal">0</div>
    <div class="sc-desc">dari spreadsheet</div>
    <div class="sc-bg">👥</div>
  </div>
  <div class="sc cg">
    <div class="sc-lbl">Selesai</div>
    <div class="sc-val" id="stDone">0</div>
    <div class="sc-desc">screenshot diambil</div>
    <div class="sc-bg">✅</div>
  </div>
  <div class="sc ca">
    <div class="sc-lbl">Pending</div>
    <div class="sc-val" id="stPending">0</div>
    <div class="sc-desc">menunggu antrian</div>
    <div class="sc-bg">⏳</div>
  </div>
  <div class="sc cr">
    <div class="sc-lbl">Gagal</div>
    <div class="sc-val" id="stFailed">0</div>
    <div class="sc-desc">perlu dicek ulang</div>
    <div class="sc-bg">❌</div>
  </div>
</div>

<div class="three-col">
  <!-- GALLERY -->
  <div class="panel">
    <div class="ph">
      <div class="pt">Galeri Screenshot</div>
      <span class="ml" id="imgLbl">0 file</span>
    </div>
    <div id="gallery" class="g-grid">
      <div class="g-empty">Belum ada screenshot</div>
    </div>
  </div>

  <!-- TABLE -->
  <div class="panel">
    <div class="ph">
      <div class="pt">Rincian Per Kontak</div>
      <div class="pa">
        <span class="ml" id="rincianCount">0 data</span>
        <button class="mb mbc" onclick="doRefresh()">↻</button>
      </div>
    </div>
    <div class="mt-wrap">
      <table class="mt">
        <thead><tr><th>Waktu</th><th>Nama/Lapor</th><th>Nomor</th><th>Status</th></tr></thead>
        <tbody id="rincianBody"></tbody>
      </table>
    </div>
  </div>

  <!-- LOGS & CONFIG -->
  <div style="display:flex;flex-direction:column;gap:14px;">
    <div class="panel">
      <div class="ph">
        <div class="pt"><span id="runLottie" class="pdot-lottie"></span> Terminal Log</div>
        <button class="mb mba" onclick="clearLog()">Clear</button>
      </div>
      <div id="logBody" class="log-body"></div>
    </div>

    <div class="panel">
      <div class="ph"><div class="pt">⚙ Konfigurasi</div></div>
      <div class="cfg-body">
        <div class="cfg-grp">
          <div class="cfg-lbl">Delay (detik)</div>
          <input class="cfg-in" id="cfgDelay" type="number" value="5"/>
        </div>
        <div class="cfg-grp">
          <div class="cfg-lbl">Retry</div>
          <input class="cfg-in" id="cfgRetry" type="number" value="2"/>
        </div>
        <div class="cfg-grp">
          <div class="cfg-lbl">ADB Path</div>
          <div class="cfg-pr">
            <input class="cfg-in" id="cfgAdb" type="text"/>
            <button class="bp" onclick="document.getElementById('filePickerInput').click()">Pilih</button>
          </div>
        </div>
        <button class="btn-save" onclick="saveConfig()">💾 Simpan</button>
      </div>
    </div>
  </div>
</div>

<div class="footer">
  <a href="https://github.com/heruahmadsidik/bot-sms-screenshot" target="_blank" class="footer-gh">⎇ GitHub Repository</a>
  <div style="text-align:right;">
    <div style="font-family:var(--mono);font-size:11px;color:var(--text2);">Built by: Heru Ahmad Sidik</div>
    <div style="font-size:10px;color:var(--text3);">&#174; Copyright 2026</div>
  </div>
</div>

</div><!-- /wrap -->

<input type="file" id="filePickerInput" onchange="document.getElementById('cfgAdb').value=this.files[0].name" />

<div id="viewer" onclick="if(event.target===this)this.classList.remove('show')">
  <div class="vbox">
    <button class="vcls" onclick="document.getElementById('viewer').classList.remove('show')">✕</button>
    <img id="vImg" src="" alt="">
    <div class="vcap" id="vCap"></div>
  </div>
</div>

<script>
let prevImg=[], prevLogLen=0;

async function doStart(){
  prevImg=[];
  document.getElementById('gallery').innerHTML='<div class="g-empty">Memulai...</div>';
  const r=await fetch('/start').then(x=>x.json()).catch(()=>({ok:false}));
  if(!r.ok){ alert(r.msg||'Gagal memulai'); return; }
  await fetch('/refresh-sheet');
}

function doStop(){ fetch('/stop'); }
async function doRefresh(){ await fetch('/refresh-sheet'); loadSheet(); }
function clearLog(){ document.getElementById('logBody').innerHTML=''; }

function openViewer(src,cap){
  document.getElementById('vImg').src=src;
  document.getElementById('vCap').textContent=cap||'';
  document.getElementById('viewer').classList.add('show');
}

async function saveConfig(){
  const d=parseInt(document.getElementById('cfgDelay').value)||5;
  const r=parseInt(document.getElementById('cfgRetry').value)||2;
  const a=document.getElementById('cfgAdb').value;
  const res=await fetch('/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({delay:d,retry:r,adbPath:a})});
  const data=await res.json();
  if(data.ok) alert('Konfigurasi disimpan');
}

async function loadConfig(){
  const c=await fetch('/config').then(r=>r.json()).catch(()=>null);
  if(!c) return;
  if(c.delay) document.getElementById('cfgDelay').value=c.delay/1000;
  if(c.retry!=null) document.getElementById('cfgRetry').value=c.retry;
  if(c.adbPath) document.getElementById('cfgAdb').value=c.adbPath;
}

async function loadSheet(){
  const d=await fetch('/sheet-data').then(r=>r.json()).catch(()=>null);
  if(!d) return;
  document.getElementById('stTotal').textContent=d.rows ? d.rows.length : 0;
}

function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

async function poll(){
  const [s,l,d]=await Promise.all([
    fetch('/status').then(r=>r.json()).catch(()=>null),
    fetch('/logs').then(r=>r.json()).catch(()=>[]),
    fetch('/device-status').then(r=>r.json()).catch(()=>null),
  ]);
  if(!s) return;

  // Device Info & Badge (Lottie Live Indictor)
  const b = document.getElementById('adbBadge');
  const runLottie = document.getElementById('runLottie');
  const liveAnim = '<dotlottie-player src="https://lottie.host/67702f74-3382-4113-9827-023a39775079/U7H6XpPZ6H.json" background="transparent" speed="1" style="width:100%;height:100%;" loop autoplay></dotlottie-player>';

  if(d && d.connected){
    b.innerHTML = '<div class="pdot-lottie">' + liveAnim + '</div> Terhubung';
    b.className = 'hero-device-badge';
    document.getElementById('devName').textContent = d.info.name || 'Device';
    document.getElementById('devSerial').textContent = 'Serial: ' + (d.info.serial || '—');
    document.getElementById('devTags').innerHTML = '<span class="tag tg">Ready</span><span class="tag tc">Android '+d.info.android+'</span>';
  } else {
    b.innerHTML = '● Terputus';
    b.className = 'hero-device-badge off';
    document.getElementById('devName').textContent = 'Device Tidak Ada';
    document.getElementById('devTags').innerHTML = '<span class="tag ta">Disconnected</span>';
  }

  // Stats
  if(s.counts){
    document.getElementById('stTotal').textContent=s.counts.total;
    document.getElementById('stDone').textContent=s.counts.done;
    document.getElementById('stPending').textContent=s.counts.pending;
    document.getElementById('stFailed').textContent=s.counts.failed;
  }
  document.getElementById('pDone').textContent=s.done;
  document.getElementById('pTotal').textContent=s.total;

  // Progress Bar
  const pf=document.getElementById('progFill');
  pf.style.width=s.progress+'%';
  pf.className = s.running ? 'prog-fill prog-fill-active' : 'prog-fill';

  // Terminal Status Lottie
  if(s.running) {
    if(!runLottie.innerHTML) runLottie.innerHTML = liveAnim;
  } else {
    runLottie.innerHTML = '';
  }

  // Rincian Table
  if(s.lastImages && s.lastImages.length){
    document.getElementById('rincianCount').textContent=s.lastImages.length+' data';
    document.getElementById('rincianBody').innerHTML=s.lastImages.map(img=>(
      '<tr><td class="ml">'+img.time+'</td><td>'+esc(img.name)+'</td><td class="ml">'+esc(img.nomor)+'</td><td><span class="bd">DONE</span></td></tr>'
    )).join('');
  }

  // Gallery
  if(JSON.stringify(prevImg)!==JSON.stringify(s.lastImages)){
    prevImg=s.lastImages;
    const g=document.getElementById('gallery');
    document.getElementById('imgLbl').textContent=s.lastImages.length+' file';
    if(!s.lastImages.length) g.innerHTML='<div class="g-empty">Belum ada screenshot</div>';
    else {
      g.innerHTML='';
      s.lastImages.forEach(img=>{
        const div=document.createElement('div');
        div.className='g-item';
        div.innerHTML='<img src="'+img.src+'" loading="lazy"><div class="g-lbl">'+esc(img.name)+'<br><span class="g-size">'+img.size+'</span></div>';
        div.onclick=()=>openViewer(img.src, img.name);
        g.appendChild(div);
      });
    }
  }

  // Logs
  if(l.length!==prevLogLen){
    prevLogLen=l.length;
    const lb=document.getElementById('logBody');
    const typeMap={ok:'OK',warn:'WARN',error:'ERR',info:'INFO',log:'LOG'};
    const cls={ok:'lok',warn:'lwarn',error:'lerr',info:'linf',log:'llog'};
    lb.innerHTML=l.map((log,i)=>(
      '<div class="le '+(i===l.length-1?'latest':'')+'"><span class="lt">'+log.time+'</span><span class="ltype '+(cls[log.type]||'llog')+'">'+(typeMap[log.type]||'LOG')+'</span><span class="lm">'+esc(log.text)+'</span></div>'
    )).join('');
    lb.scrollTop=lb.scrollHeight;
  }
}

loadConfig();
loadSheet();
setInterval(poll,1500);
</script>
</body>
</html>`);
});

app.listen(PORT, () => {
  addLog("🚀 Server aktif di http://localhost:" + PORT, "info");
});
