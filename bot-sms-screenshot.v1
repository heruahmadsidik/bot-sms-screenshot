.bd{background:rgba(0,230,118,.1);color:var(--green);border:1px solid rgba(0,230,118,.3);font-size:10px;padding:1px 8px;border-radius:3px;font-family:var(--mono);}
.br{background:rgba(255,171,0,.1);color:var(--amber);border:1px solid rgba(255,171,0,.3);font-size:10px;padding:1px 8px;border-radius:3px;font-family:var(--mono);}
.bf{background:rgba(255,61,87,.1);color:var(--red);border:1px solid rgba(255,61,87,.3);font-size:10px;padding:1px 8px;border-radius:3px;font-family:var(--mono);}

/* CONFIG */
.cfg-body{padding:14px;display:flex;flex-direction:column;gap:10px;}
.cfg-grp{display:flex;flex-direction:column;gap:4px;}
.cfg-lbl{font-size:10px;color:var(--text2);letter-spacing:1px;text-transform:uppercase;}
.cfg-in{background:var(--bg);border:1px solid var(--border2);border-radius:5px;color:var(--text);font-family:var(--mono);font-size:12px;padding:7px 10px;width:100%;transition:border-color .2s;}
.cfg-in:focus{outline:none;border-color:var(--cyan);}
.cfg-pr{display:flex;gap:6px;}
.cfg-pr .cfg-in{flex:1;}
.bp{font-family:var(--mono);font-size:10px;padding:0 10px;background:rgba(0,212,255,.08);border:1px solid rgba(0,212,255,.3);color:var(--cyan);border-radius:5px;cursor:pointer;white-space:nowrap;transition:all .2s;}
.bp:hover{background:rgba(0,212,255,.2);}
.btn-save{font-family:var(--body);font-weight:600;font-size:13px;padding:9px;border-radius:6px;border:1px solid rgba(0,212,255,.4);cursor:pointer;background:linear-gradient(135deg,rgba(0,212,255,.2),rgba(124,77,255,.2));color:var(--cyan);text-align:center;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;}
.btn-save:hover{background:linear-gradient(135deg,rgba(0,212,255,.3),rgba(124,77,255,.3));box-shadow:0 0 14px rgba(0,212,255,.3);}

/* TERMINAL LOG - fixed height */
.log-body{flex:1;overflow-y:auto;padding:8px 10px;font-family:var(--mono);font-size:11px;max-height:280px;min-height:200px;}
.le{display:flex;gap:8px;padding:2px 0;line-height:1.6;}
.lt{color:var(--text3);flex-shrink:0;}
.ltype{flex-shrink:0;font-size:10px;padding:0 5px;border-radius:2px;align-self:flex-start;margin-top:2px;}
.lok{background:rgba(0,230,118,.15);color:var(--green);}
.lwarn{background:rgba(255,171,0,.15);color:var(--amber);}
.lerr{background:rgba(255,61,87,.15);color:var(--red);}
.linf{background:rgba(0,212,255,.15);color:var(--cyan);}
.llog{background:rgba(255,255,255,.05);color:var(--text2);}
.lm{color:var(--text);flex:1;}
.le.latest .lm{color:var(--cyan);}

/* FULL TABLE */
.ft-section{margin-top:14px;}
.tw{overflow-x:auto;}
.ft{width:100%;border-collapse:collapse;font-size:13px;}
.ft th{text-align:left;font-family:var(--mono);font-size:10px;font-weight:400;color:var(--text2);letter-spacing:1.5px;padding:9px 14px;border-bottom:1px solid var(--border);text-transform:uppercase;background:var(--bg3);}
.ft td{padding:10px 14px;border-bottom:1px solid rgba(30,45,69,.5);color:var(--text);}
.ft tr:last-child td{border-bottom:none;}
.ft tr:hover td{background:rgba(0,212,255,.03);}
.nc{color:var(--text2);font-family:var(--mono);font-size:11px;}
.nmc{font-weight:600;color:var(--text);}
.noc{font-family:var(--mono);font-size:12px;color:var(--text2);}

/* BOTTOM ROW */
.bot-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px;}

/* FOOTER */
.footer{display:flex;align-items:flex-end;justify-content:space-between;padding:20px 0 8px;border-top:1px solid var(--border);margin-top:20px;}
.footer-left{display:flex;flex-direction:column;gap:4px;}
.footer-gh{font-family:var(--mono);font-size:11px;color:var(--cyan);text-decoration:none;letter-spacing:.5px;display:flex;align-items:center;gap:6px;transition:all .2s;}
.footer-gh:hover{color:#fff;text-shadow:0 0 10px var(--cyan);}
.footer-gh::before{content:'⎇';font-size:13px;}
.footer-right{text-align:right;}
.footer-built{font-family:var(--mono);font-size:11px;color:var(--text2);letter-spacing:1px;}
.footer-copy{font-size:10px;color:var(--text3);margin-top:3px;font-family:var(--mono);}

/* PROGRESS ANIMATION */
@keyframes prog-pulse{0%,100%{box-shadow:0 0 6px rgba(0,212,255,.5);}50%{box-shadow:0 0 18px rgba(0,212,255,.9),0 0 30px rgba(0,212,255,.4);}}
@keyframes prog-stripe{0%{background-position:0 0;}100%{background-position:40px 0;}}
.prog-fill-active{background:repeating-linear-gradient(90deg,var(--cyan) 0px,rgba(0,212,255,.7) 10px,var(--cyan) 20px);background-size:40px 100%;animation:prog-stripe .6s linear infinite,prog-pulse 1.5s ease-in-out infinite;}
.prog-nums-running{animation:numglow 1s ease-in-out infinite;}
@keyframes numglow{0%,100%{text-shadow:0 0 8px rgba(0,212,255,.4);}50%{text-shadow:0 0 20px rgba(0,212,255,.9),0 0 40px rgba(0,212,255,.4);}}

/* LIGHTBOX */
#viewer{position:fixed;inset:0;background:rgba(5,8,15,.95);backdrop-filter:blur(10px);display:none;justify-content:center;align-items:center;z-index:999;}
#viewer.show{display:flex;}
.vbox{position:relative;}
#vImg{max-width:90vw;max-height:88vh;border-radius:8px;border:1px solid var(--border);box-shadow:0 0 60px rgba(0,212,255,.15);}
.vcls{position:absolute;top:-12px;right:-12px;width:26px;height:26px;border-radius:50%;background:var(--red);border:none;cursor:pointer;font-size:13px;color:white;display:flex;align-items:center;justify-content:center;}
.vcap{text-align:center;margin-top:10px;font-family:var(--mono);font-size:11px;color:var(--text2);}

/* HIDDEN FILE INPUT */
#filePickerInput{display:none;}
</style>
</head>
<body>
<div class="wrap">

<!-- HERO TOP BAR -->
<div class="hero">
  <!-- LEFT: ADB Info -->
  <div class="hero-left">
    <div class="hero-adb-icon">🤖</div>
    <div class="hero-adb-info">
      <div class="hero-adb-label">ADB Control Panel</div>
      <div class="hero-adb-port">port 3000 · v2.0</div>
    </div>
    <div class="hero-divider"></div>
    <div class="hero-adb-info">
      <div class="hero-adb-label" style="color:var(--text2);">PLN UP2D Banten</div>
      <div class="hero-adb-port">Bot Screenshot</div>
    </div>
  </div>

  <!-- CENTER: Title -->
  <div class="hero-center">
    <div class="hero-title">COMMAND CENTER</div>
    <div class="hero-dot"></div>
  </div>

  <!-- RIGHT: Device Status -->
  <div class="hero-right">
    <div id="adbBadge" class="hero-device-badge off">● Mengecek device...</div>
    <div id="devSerial" class="hero-device-detail">Hubungkan perangkat Android via USB</div>
  </div>
</div>

<!-- ADB PANEL -->
<div class="adb-panel">
  <div class="adb-body">
    <div class="dev-icon">📱</div>
    <div class="dev-info">
      <div class="dev-name" id="devName">Menunggu device...</div>
      <div class="dev-tags" id="devTags">
        <span class="tag ta">Disconnected</span>
      </div>
    </div>
    <div class="prog-sec">
      <div class="prog-lbl">Progress Sesi Ini</div>
      <div class="prog-nums"><span id="pDone">0</span> / <span id="pTotal">0</span></div>
      <div class="prog-sub">screenshot diambil</div>
      <div class="prog-bar"><div id="progFill" class="prog-fill"></div></div>
    </div>
  </div>

  <div class="btn-row">
    <button class="btn btn-start" onclick="doStart()">▶ Mulai Screenshot</button>
    <button class="btn btn-stop"  onclick="doStop()">⏹ Stop</button>
  </div>
</div>

<!-- STAT CARDS -->
<div class="stat-grid">
  <div class="sc cc">
    <div class="sc-lbl">Total Kontak</div>
    <div class="sc-val" id="stTotal">0</div>
    <div class="sc-desc">dari spreadsheet</div>
    <div class="sc-bg">👥</div>
  </div>
  <div class="sc cg">
    <div class="sc-lbl">Selesai</div>
    <div class="sc-val" id="stDone">0</div>
    <div class="sc-desc">screenshot diambil</div>
    <div class="sc-bg">✅</div>
  </div>
  <div class="sc ca">
    <div class="sc-lbl">Pending</div>
    <div class="sc-val" id="stPending">0</div>
    <div class="sc-desc">menunggu antrian</div>
    <div class="sc-bg">⏳</div>
  </div>
  <div class="sc cr">
    <div class="sc-lbl">Gagal</div>
    <div class="sc-val" id="stFailed">0</div>
    <div class="sc-desc">perlu dicek ulang</div>
    <div class="sc-bg">❌</div>
  </div>
</div>

<!-- THREE COL: Gallery | Rincian | Log+Config -->
<div class="three-col">

  <!-- GALLERY -->
  <div class="panel">
    <div class="ph">
      <div class="pt"><span class="pdot dc"></span>Galeri Screenshot</div>
      <span class="ml" id="imgLbl">0 file</span>
    </div>
    <div id="gallery" class="g-grid">
      <div class="g-empty">Belum ada screenshot</div>
    </div>
  </div>

  <!-- RINCIAN PER KONTAK -->
  <div class="panel">
    <div class="ph">
      <div class="pt"><span class="pdot dg"></span>Rincian Per Kontak</div>
      <div class="pa">
        <span class="ml" id="rincianCount">0 data</span>
        <button class="mb mbc" onclick="doRefresh()">↻</button>
      </div>
    </div>
    <div class="mt-wrap">
      <table class="mt">
        <thead><tr><th>Waktu</th><th>No Lapor</th><th>Nomor</th><th>Status</th></tr></thead>
        <tbody id="rincianBody">
          <tr><td colspan="4" style="color:var(--text3);text-align:center;padding:16px;font-size:11px;">Belum ada data</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- TERMINAL LOG + KONFIGURASI -->
  <div style="display:flex;flex-direction:column;gap:14px;">

    <!-- TERMINAL LOG (atas) -->
    <div class="panel">
      <div class="ph">
        <div class="pt"><span id="runDot" class="pdot" style="background:var(--text3);box-shadow:none;animation:none;"></span>Terminal Log</div>
        <button class="mb mba" onclick="clearLog()">Clear</button>
      </div>
      <div id="logBody" class="log-body"></div>
    </div>

    <!-- KONFIGURASI (bawah) -->
    <div class="panel">
      <div class="ph">
        <div class="pt"><span class="pdot da"></span>⚙ Konfigurasi</div>
      </div>
      <div class="cfg-body">
        <div class="cfg-grp">
          <div class="cfg-lbl">Delay Antar SMS (detik)</div>
          <input class="cfg-in" id="cfgDelay" type="number" value="5" min="1" max="30"/>
        </div>
        <div class="cfg-grp">
          <div class="cfg-lbl">Retry Jika Gagal</div>
          <input class="cfg-in" id="cfgRetry" type="number" value="2" min="0" max="5"/>
        </div>
        <div class="cfg-grp">
          <div class="cfg-lbl">📁 Folder Screenshot</div>
          <div class="cfg-pr">
            <input class="cfg-in" id="cfgSsDir" type="text" placeholder="C:\\Users\\...\\screenshots"/>
            <button class="bp" onclick="pickFolder('cfgSsDir')">Pilih</button>
          </div>
        </div>
        <div class="cfg-grp">
          <div class="cfg-lbl">📁 Folder Project</div>
          <div class="cfg-pr">
            <input class="cfg-in" id="cfgProjDir" type="text" placeholder="C:\\Users\\...\\bot-sms"/>
            <button class="bp" onclick="pickFolder('cfgProjDir')">Pilih</button>
          </div>
        </div>
        <div class="cfg-grp">
          <div class="cfg-lbl">📱 ADB Path</div>
          <div class="cfg-pr">
            <input class="cfg-in" id="cfgAdb" type="text" placeholder="C:\\Users\\...\\adb.exe"/>
            <button class="bp" onclick="pickFile('cfgAdb')">Pilih</button>
          </div>
        </div>
        <button class="btn-save" onclick="saveConfig()">💾 Simpan Konfigurasi</button>
      </div>
    </div>

  </div>
</div>

<!-- FOOTER -->
<div class="footer">
  <div class="footer-left">
    <a href="https://github.com/heruahmadsidik/bot-sms-screenshot" target="_blank" rel="noopener" class="footer-gh">https://github.com/heruahmadsidik/bot-sms-screenshot</a>
  </div>
  <div class="footer-right">
    <div class="footer-built">Built with bismillah by: Heru Ahmad Sidik</div>
    <div class="footer-copy">&#174; Copyright 2026</div>
  </div>
</div>

</div><!-- /wrap -->

<!-- HIDDEN FILE/FOLDER INPUT -->
<input type="file" id="filePickerInput" />
<input type="file" id="folderPickerInput" webkitdirectory />

<!-- LIGHTBOX -->
<div id="viewer" onclick="cvClose(event)">
  <div class="vbox">
    <button class="vcls" onclick="document.getElementById('viewer').classList.remove('show')">✕</button>
    <img id="vImg" src="" alt="">
    <div class="vcap" id="vCap"></div>
  </div>
</div>

<script>
let prevImg=[], prevLogLen=0;

// File/Folder picker using native browser input
function pickFile(targetId) {
  const inp = document.getElementById('filePickerInput');
  inp.accept = '.exe,*';
  inp.onchange = function(e) {
    const file = e.target.files[0];
    if (file) {
      // Try to get full path - modern browsers block this for security
      // We show the file name and let user manually edit if needed
      const val = file.name;
      // Try webkitRelativePath or use file name
      document.getElementById(targetId).value = file.name;
      // Show hint
      showPathHint(targetId, file.name);
    }
    inp.value = '';
  };
  inp.click();
}

function pickFolder(targetId) {
  const inp = document.getElementById('folderPickerInput');
  inp.onchange = function(e) {
    const files = e.target.files;
    if (files && files.length > 0) {
      // Get folder path from webkitRelativePath
      const rel = files[0].webkitRelativePath;
      const folderName = rel ? rel.split('/')[0] : files[0].name;
      document.getElementById(targetId).value = folderName;
      showPathHint(targetId, folderName);
    }
    inp.value = '';
  };
  inp.click();
}

function showPathHint(targetId, name) {
  const inp = document.getElementById(targetId);
  inp.style.borderColor = 'var(--cyan)';
  inp.title = 'Nama: ' + name + ' — Ketik path lengkap jika perlu (browser tidak mengizinkan akses path penuh)';
  setTimeout(() => { inp.style.borderColor = ''; }, 2000);
}

// Actions
async function doStart(){
  // Reset gallery display immediately
  prevImg=[];
  document.getElementById('gallery').innerHTML='<div class="g-empty">Memulai sesi baru...</div>';
  document.getElementById('imgLbl').textContent='0 file';
  document.getElementById('rincianBody').innerHTML='<tr><td colspan="4" style="color:var(--text3);text-align:center;padding:16px;font-size:11px;">Memulai...</td></tr>';
  document.getElementById('rincianCount').textContent='0 data';
  const r=await fetch('/start').then(x=>x.json()).catch(()=>({ok:false}));
  if(!r.ok){ alert(r.msg||'Gagal memulai'); return; }
  // immediately refresh sheet so total count updates
  await fetch('/refresh-sheet');
}
function doStop(){ fetch('/stop'); }
async function doRefresh(){ await fetch('/refresh-sheet'); await loadSheet(); }
function clearLog(){ document.getElementById('logBody').innerHTML=''; }

function cvClose(e){ if(e.target===document.getElementById('viewer')) document.getElementById('viewer').classList.remove('show'); }
function openViewer(src,cap){
  document.getElementById('vImg').src=src;
  document.getElementById('vCap').textContent=cap||'';
  document.getElementById('viewer').classList.add('show');
}

async function saveConfig(){
  const d=parseInt(document.getElementById('cfgDelay').value)||5;
  const r=parseInt(document.getElementById('cfgRetry').value)||2;
  const a=document.getElementById('cfgAdb').value;
  const ss=document.getElementById('cfgSsDir').value;
  const pj=document.getElementById('cfgProjDir').value;
  const res=await fetch('/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({delay:d,retry:r,adbPath:a,ssDir:ss,projDir:pj})});
  const data=await res.json();
  if(data.ok){
    const btn=document.querySelector('.btn-save');
    const orig=btn.innerHTML;
    btn.innerHTML='✅ Tersimpan!';
    btn.style.borderColor='var(--green)';
    btn.style.color='var(--green)';
    setTimeout(()=>{btn.innerHTML=orig;btn.style.borderColor='';btn.style.color='';},2000);
  }
}

// Load config on init
async function loadConfig(){
  const c=await fetch('/config').then(r=>r.json()).catch(()=>null);
  if(!c) return;
  if(c.delay) document.getElementById('cfgDelay').value=c.delay/1000;
  if(c.retry!=null) document.getElementById('cfgRetry').value=c.retry;
  if(c.adbPath) document.getElementById('cfgAdb').value=c.adbPath;
  if(c.ssDir) document.getElementById('cfgSsDir').value=c.ssDir;
  if(c.projDir) document.getElementById('cfgProjDir').value=c.projDir;
}

async function loadSheet(){
  const d=await fetch('/sheet-data').then(r=>r.json()).catch(()=>null);
  if(!d) return;
  const rows=d.rows||[];
  const doneC=rows.filter(r=>r[2]==='DONE').length;
  const failC=rows.filter(r=>r[2]==='FAILED').length;
  const pendC=rows.filter(r=>!r[2]||r[2]===''||r[2]==='READY').length;
  document.getElementById('stTotal').textContent=rows.length;
  document.getElementById('stDone').textContent=doneC;
  document.getElementById('stPending').textContent=pendC;
  document.getElementById('stFailed').textContent=failC;
}

function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

async function poll(){
  const [s,l,d]=await Promise.all([
    fetch('/status').then(r=>r.json()).catch(()=>null),
    fetch('/logs').then(r=>r.json()).catch(()=>[]),
    fetch('/device-status').then(r=>r.json()).catch(()=>null),
  ]);
  if(!s) return;

  // Device
  if(d){
    const b=document.getElementById('adbBadge');
    if(d.connected){
      b.textContent='● '+(d.info.name||'Device')+' — Terhubung';
      b.className='hero-device-badge';
      document.getElementById('devName').textContent=d.info.name||'Device';
      document.getElementById('devSerial').textContent='Serial: '+(d.info.serial||'—')+' · Android '+(d.info.android||'—');
      document.getElementById('devTags').innerHTML='<span class="tag tg">Device Ready</span>'+(d.info.android?'<span class="tag tc">Android '+d.info.android+'</span>':'')+(d.info.usbDebug?'<span class="tag ta">USB Debug: ON</span>':'');
    } else {
      b.textContent='● Tidak Ada Device';
      b.className='hero-device-badge off';
      document.getElementById('devName').textContent='Tidak ada device terdeteksi';
      document.getElementById('devSerial').textContent='Hubungkan perangkat Android via USB';
      document.getElementById('devTags').innerHTML='<span class="tag ta">Disconnected</span>';
    }
  }

  // Stat cards - real-time from server counts
  if(s.counts){
    document.getElementById('stTotal').textContent=s.counts.total;
    document.getElementById('stDone').textContent=s.counts.done;
    document.getElementById('stPending').textContent=s.counts.pending;
    document.getElementById('stFailed').textContent=s.counts.failed;
  }
  document.getElementById('pDone').textContent=s.done;
  document.getElementById('pTotal').textContent=s.total;

  // Progress bar animation
  const pf=document.getElementById('progFill');
  pf.style.width=s.progress+'%';
  if(s.running && s.total>0){
    pf.className='prog-fill prog-fill-active';
    document.getElementById('pDone').closest('.prog-nums').className='prog-nums prog-nums-running';
  } else {
    pf.className='prog-fill';
    document.getElementById('pDone').closest('.prog-nums').className='prog-nums';
  }

  // Running dot
  const rd=document.getElementById('runDot');
  if(s.running){ rd.className='pdot dg'; rd.style=''; }
  else { rd.style='background:var(--text3);box-shadow:none;animation:none;'; }

  // Rincian - include phone number from sheetData lookup
  if(s.lastImages&&s.lastImages.length){
    const rb=document.getElementById('rincianBody');
    document.getElementById('rincianCount').textContent=s.lastImages.length+' data';
    rb.innerHTML=s.lastImages.map(img=>{
      const nomor=img.nomor||'—';
      return '<tr><td class="nc">'+(img.time||'--:--')+'</td><td>'+esc(img.name||'—')+'</td><td class="noc">'+esc(nomor)+'</td><td><span class="bd">BERHASIL</span></td></tr>';
    }).join('');
  }

  // Gallery - fixed height, show actual file size
  if(JSON.stringify(prevImg)!==JSON.stringify(s.lastImages)){
    prevImg=s.lastImages;
    const g=document.getElementById('gallery');
    document.getElementById('imgLbl').textContent=s.lastImages.length+' file';
    if(!s.lastImages.length){
      g.innerHTML='<div class="g-empty">Belum ada screenshot</div>';
    } else {
      g.innerHTML='';
      s.lastImages.forEach(img=>{
        const src=img.src||img;
        const name=img.name||src.split('/').pop().replace('.png','');
        const time=img.time||'';
        const size=img.size||'';
        const div=document.createElement('div');
        div.className='g-item';
        div.innerHTML='<img src="'+src+'" alt="'+esc(name)+'" loading="lazy"><div class="g-lbl">'+esc(name)+'<br><span class="g-size">'+esc(size)+'</span></div>';
        div.onclick=()=>openViewer(src,name+' · '+time+' · '+size);
        g.appendChild(div);
      });
    }
  }

  // Logs - fixed height (CSS handles it)
  if(l.length!==prevLogLen){
    prevLogLen=l.length;
    const lb=document.getElementById('logBody');
    const atBottom=lb.scrollHeight-lb.scrollTop-lb.clientHeight<80;
    const typeMap={ok:'OK',warn:'WARN',error:'ERR',info:'INFO',log:'LOG'};
    const cls={ok:'lok',warn:'lwarn',error:'lerr',info:'linf',log:'llog'};
    lb.innerHTML='';
    l.forEach((log,i)=>{
      const div=document.createElement('div');
      div.className='le'+(i===l.length-1?' latest':'');
      div.innerHTML='<span class="lt">'+log.time+'</span><span class="ltype '+(cls[log.type]||'llog')+'">'+(typeMap[log.type]||'LOG')+'</span><span class="lm">'+esc(log.text)+'</span>';
      lb.appendChild(div);
    });
    if(atBottom) lb.scrollTop=lb.scrollHeight;
  }
}

loadConfig();
loadSheet();
setInterval(poll,1200);
poll();
</script>
</body>
</html>`);
});

// ================= RUN =================
app.listen(PORT, () => {
  addLog("🚀 Server aktif di http://localhost:" + PORT, "info");
  console.log("🚀 http://localhost:" + PORT);
});
