.g-size{font-size:8px;color:var(--cyan);opacity:.9;}
.g-empty{grid-column:1/-1;text-align:center;padding:30px;color:var(--text3);font-size:12px;letter-spacing:1px;}

/* MINI TABLE */
.mt-wrap{padding:0 14px 12px;overflow-y:auto;max-height:600px;}
