.sc-val{font-family:var(--orb);font-size:38px;font-weight:800;line-height:1;margin:8px 0 4px;}
.cc .sc-val{color:var(--cyan);text-shadow:0 0 20px rgba(0,212,255,.4);}
.cg .sc-val{color:var(--green);text-shadow:0 0 20px rgba(0,230,118,.4);}
.ca .sc-val{color:var(--amber);text-shadow:0 0 20px rgba(255,171,0,.4);}
.cr .sc-val{color:var(--red);text-shadow:0 0 20px rgba(255,61,87,.4);}
.sc-desc{font-size:11px;color:var(--text2);}
.sc-bg{position:absolute;right:12px;bottom:10px;font-size:44px;opacity:1;filter:drop-shadow(0 0 4px rgba(255,255,255,.2));}

/* THREE COL LAYOUT - gallery left, config right */
