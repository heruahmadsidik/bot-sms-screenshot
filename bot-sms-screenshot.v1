const express = require("express");
const { google } = require("googleapis");
const { execSync } = require("child_process");
const notifier = require("node-notifier");
const fs = require("fs");
const path = require("path");

// ================= CONFIG =================
const SPREADSHEET_ID = "1MlYstlcJdUurTSthIabeWdpjVwOgDdN8B3cWQso1H78";
const SHEET_NAME = "Sheet1";
let CONFIG = { delay: 5000, retry: 2, adbPath: "C:\\Users\\herua\\Documents\\bot-sms\\platform-tools\\adb.exe" };
// ==========================================

const app = express();
const PORT = 3000;
app.use(express.json());

// ================= STATE =================
let logs = [];
let isRunning = false;
let stopRequested = false;
let progress = 0;
let total = 0;
let done = 0;
let failed = 0;
let lastImages = [];
let sheetData = [];
let deviceInfo = { name: "Unknown", serial: "", android: "", usbDebug: false };

// ================= LOG =================
function addLog(msg, type) {
  const time = new Date().toLocaleTimeString("id-ID", { hour12: false });
  if (!type) {
    if (msg.includes("❌") || msg.includes("FAILED")) type = "error";
    else if (msg.includes("⚠️") || msg.includes("Retry") || msg.includes("retry")) type = "warn";
    else if (msg.includes("✅") || msg.includes("DONE") || msg.includes("📸") || msg.includes("berhasil")) type = "ok";
    else if (msg.includes("🚀") || msg.includes("🎉") || msg.includes("📊") || msg.includes("ℹ")) type = "info";
    else type = "log";
  }
  const log = { text: msg, time, type };
  console.log("[" + time + "] " + msg);
  logs.push(log);
  if (logs.length > 500) logs.shift();
}

// ================= FOLDER =================
const SCREENSHOT_DIR = path.join(__dirname, "screenshots");
if (!fs.existsSync(SCREENSHOT_DIR)) fs.mkdirSync(SCREENSHOT_DIR);
app.use("/screenshots", express.static(SCREENSHOT_DIR));

// ================= GOOGLE =================
const auth = new google.auth.GoogleAuth({
  keyFile: "credentials.json",
  scopes: ["https://www.googleapis.com/auth/spreadsheets"],
});

// ================= UTIL =================
function sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }
function safeName(t) { return t.trim().replace(/[\\/:*?"<>|]/g, ""); }

// ================= DEVICE =================
function checkDevice() {
  try {
    const out = execSync('"' + CONFIG.adbPath + '" devices').toString();
    return out.includes("device");
  } catch (e) { return false; }
}

function getDeviceInfo() {
  try {
    const model  = execSync('"' + CONFIG.adbPath + '" shell getprop ro.product.model').toString().trim();
    const serial = execSync('"' + CONFIG.adbPath + '" shell getprop ro.serialno').toString().trim();
    const ver    = execSync('"' + CONFIG.adbPath + '" shell getprop ro.build.version.release').toString().trim();
    deviceInfo = { name: model, serial, android: ver, usbDebug: true };
  } catch (e) {
    deviceInfo = { name: "Unknown", serial: "", android: "", usbDebug: false };
  }
}

app.get("/device-status", (req, res) => {
  try {
    const out = execSync('"' + CONFIG.adbPath + '" devices').toString();
    const lines = out.split("\n").filter(l => l.trim() && !l.includes("List"));
    const devices = lines.filter(l => l.includes("device"));
    if (devices.length > 0) getDeviceInfo();
    res.json({ connected: devices.length > 0, count: devices.length, info: deviceInfo });
  } catch (e) {
    res.json({ connected: false, count: 0, info: deviceInfo });
  }
});

// ================= SHEET =================
async function getData() {
  addLog("📄 Membaca Google Sheets...", "info");
  const client = await auth.getClient();
  const sheets = google.sheets({ version: "v4", auth: client });
  const res = await sheets.spreadsheets.values.get({
    spreadsheetId: SPREADSHEET_ID,
    range: SHEET_NAME + "!A2:C",
  });
  sheetData = res.data.values || [];
  addLog("✅ " + sheetData.length + " kontak dimuat", "ok");
  return sheetData;
}

async function updateStatus(row, status) {
  const client = await auth.getClient();
  const sheets = google.sheets({ version: "v4", auth: client });
  await sheets.spreadsheets.values.update({
    spreadsheetId: SPREADSHEET_ID,
    range: SHEET_NAME + "!C" + row,
    valueInputOption: "RAW",
    requestBody: { values: [[status]] },
  });
  if (sheetData[row - 2]) sheetData[row - 2][2] = status;
}

app.get("/sheet-data",    (req, res) => res.json({ rows: sheetData, sheet: SHEET_NAME }));
app.get("/refresh-sheet", async (req, res) => {
  try { await getData(); res.json({ ok: true, count: sheetData.length }); }
  catch (e) { res.json({ ok: false, error: e.message }); }
});

// ================= SCREENSHOT =================
async function screenshotSMS(nomor, nama, rowIndex) {
  let attempt = 0;
  while (attempt <= CONFIG.retry) {
    try {
      addLog("📱 Membuka SMS: " + nama + " (" + nomor + ")", "log");
      execSync('"' + CONFIG.adbPath + '" shell am start -a android.intent.action.VIEW -d sms:' + nomor);
      await sleep(4000);
      const fileName = safeName(nama) + ".png";
      const filePath = path.join(SCREENSHOT_DIR, fileName);
      execSync('"' + CONFIG.adbPath + '" exec-out screencap -p > "' + filePath + '"', { shell: true });
      const stat = fs.statSync(filePath);
      const imgPath = "/screenshots/" + fileName;
      lastImages.unshift({
        src: imgPath, name: nama, nomor: nomor,
        time: new Date().toLocaleTimeString("id-ID", { hour12: false }),
        size: (stat.size / 1024).toFixed(1) + " KB"
      });
      if (lastImages.length > 20) lastImages.pop();
      addLog("📸 Screenshot berhasil: " + fileName, "ok");
      await updateStatus(rowIndex, "DONE");
      done++;
      progress = Math.floor((done / total) * 100);
      return;
    } catch (e) {
      attempt++;
      addLog("⚠️ Gagal, retry " + attempt + "/" + CONFIG.retry + ": " + nama, "warn");
      if (attempt > CONFIG.retry) {
        await updateStatus(rowIndex, "FAILED");
        failed++;
        addLog("❌ GAGAL (maks retry): " + nama, "error");
      }
    }
  }
}

// ================= MAIN =================
async function processAll() {
  if (isRunning) return;
  isRunning = true;
  stopRequested = false;
  done = 0; failed = 0; progress = 0;
  addLog("🚀 Proses dimulai", "info");
  try {
    const data = await getData();
    const pending = data.filter(d => !d[2] || d[2] === "" || d[2] === "READY");
    total = pending.length;
    addLog("📊 " + total + " kontak akan diproses", "info");
    for (let i = 0; i < data.length; i++) {
      if (stopRequested) { addLog("⏹ Dihentikan oleh pengguna", "warn"); break; }
      const [nama, nomor, status] = data[i];
      if (!nama || !nomor) continue;
      if (!status || status === "" || status === "READY") {
        await screenshotSMS(nomor, nama, i + 2);
        await sleep(CONFIG.delay);
      }
    }
  } catch (e) { addLog("❌ Error: " + e.message, "error"); }
  isRunning = false;
  notifier.notify({ title: "Bot SMS Selesai", message: done + " berhasil, " + failed + " gagal" });
  addLog("🎉 Selesai — " + done + " berhasil, " + failed + " gagal", "ok");
}

// ================= API =================
app.get("/start",  (req, res) => {
  if (!checkDevice()) return res.json({ ok: false, msg: "Device tidak terdeteksi" });
  lastImages = []; // reset gallery on new start
  processAll();
  res.json({ ok: true });
});
app.get("/stop",   (req, res) => { stopRequested = true; res.json({ ok: true }); });
app.get("/logs",   (req, res) => res.json(logs));
app.get("/status", (req, res) => {
  const doneC = sheetData.filter(r => r[2] === 'DONE').length;
  const failC = sheetData.filter(r => r[2] === 'FAILED').length;
  const pendC = sheetData.filter(r => !r[2] || r[2] === '' || r[2] === 'READY').length;
  res.json({ progress, done, total, failed, running: isRunning, lastImages, counts: { total: sheetData.length, done: doneC, pending: pendC, failed: failC } });
});
app.post("/config", (req, res) => {
  const b = req.body || {};
  if (b.delay) CONFIG.delay = parseInt(b.delay) * 1000;
  if (b.retry) CONFIG.retry = parseInt(b.retry);
  if (b.adbPath) CONFIG.adbPath = b.adbPath;
  if (b.ssDir) CONFIG.ssDir = b.ssDir;
  if (b.projDir) CONFIG.projDir = b.projDir;
  addLog("⚙ Konfigurasi disimpan", "info");
  res.json({ ok: true, config: CONFIG });
});
app.get("/config", (req, res) => res.json(CONFIG));

// ================= UI =================
app.get("/", (req, res) => {
  res.send(`<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Bot SMS — Command Center</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Exo+2:wght@300;400;500;600;700&family=Orbitron:wght@600;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0f1a; --bg2:#0d1525; --bg3:#111d30;
  --border:#1e2d45; --border2:#243550;
  --cyan:#00d4ff; --green:#00e676; --red:#ff3d57; --amber:#ffab00; --purple:#7c4dff;
  --text:#e8edf8; --text2:#b0c4de; --text3:#7a90b0;
  --mono:'Share Tech Mono',monospace; --body:'Exo 2',sans-serif; --orb:'Orbitron',monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text);font-family:var(--body);min-height:100vh;position:relative;}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse 80% 50% at 50% -10%,rgba(0,212,255,.07),transparent);pointer-events:none;z-index:0;}
::-webkit-scrollbar{width:5px;height:5px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px;}

/* FULL WIDTH */
.wrap{position:relative;z-index:1;max-width:1600px;margin:0 auto;padding:0 24px 40px;}

/* HERO - redesigned as top bar */
.hero{display:flex;align-items:center;justify-content:space-between;padding:16px 0 14px;position:relative;}
.hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);}
.hero-left{display:flex;align-items:center;gap:14px;}
.hero-adb-info{display:flex;flex-direction:column;gap:2px;}
.hero-adb-label{font-family:var(--orb);font-size:10px;color:var(--cyan);letter-spacing:1px;}
.hero-adb-port{font-family:var(--mono);font-size:10px;color:var(--text3);}
.hero-adb-icon{width:36px;height:36px;background:rgba(0,212,255,.1);border:1px solid rgba(0,212,255,.3);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
.hero-divider{width:1px;height:36px;background:var(--border2);}
.hero-center{text-align:center;flex:1;}
.hero-title{font-family:var(--orb);font-size:30px;font-weight:800;color:var(--cyan);letter-spacing:6px;text-shadow:0 0 30px rgba(0,212,255,.5),0 0 60px rgba(0,212,255,.2);animation:tglow 3s ease-in-out infinite;}
@keyframes tglow{0%,100%{text-shadow:0 0 20px rgba(0,212,255,.4),0 0 50px rgba(0,212,255,.15);}50%{text-shadow:0 0 35px rgba(0,212,255,.7),0 0 80px rgba(0,212,255,.3);}}
.hero-sub{font-family:var(--orb);font-size:10px;letter-spacing:4px;color:var(--text2);margin-top:3px;}
.hero-org{font-size:10px;letter-spacing:2px;color:var(--text3);margin-top:1px;}
.hero-dot{width:7px;height:7px;border-radius:50%;background:var(--cyan);margin:6px auto 0;box-shadow:0 0 10px var(--cyan);animation:blink 2s ease-in-out infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
.hero-right{display:flex;flex-direction:column;align-items:flex-end;gap:6px;}
.hero-device-badge{font-family:var(--mono);font-size:11px;padding:6px 14px;border-radius:6px;border:1px solid var(--green);color:var(--green);display:flex;align-items:center;gap:8px;background:rgba(0,230,118,.05);}
.hero-device-badge.off{border-color:var(--red);color:var(--red);background:rgba(255,61,87,.05);}
.hero-device-detail{font-family:var(--mono);font-size:10px;color:var(--text3);text-align:right;}

/* ADB PANEL - streamlined */
.adb-panel{background:var(--bg2);border:1px solid var(--border);border-radius:10px;margin-top:14px;overflow:hidden;}
.adb-body{display:flex;align-items:center;padding:12px 20px;gap:16px;}
.dev-icon{width:40px;height:64px;border:2px solid var(--border2);border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:20px;background:linear-gradient(180deg,rgba(0,212,255,.05),transparent);flex-shrink:0;}
.dev-info{flex:1;}
.dev-name{font-weight:600;font-size:14px;color:var(--text);}
.dev-serial{font-family:var(--mono);font-size:10px;color:var(--text3);margin-top:2px;}
.dev-tags{display:flex;gap:6px;margin-top:6px;flex-wrap:wrap;}
.tag{font-size:10px;padding:2px 8px;border-radius:3px;font-family:var(--mono);}
.tg{background:rgba(0,230,118,.1);color:var(--green);border:1px solid rgba(0,230,118,.3);}
.tc{background:rgba(0,212,255,.1);color:var(--cyan);border:1px solid rgba(0,212,255,.3);}
.ta{background:rgba(255,171,0,.1);color:var(--amber);border:1px solid rgba(255,171,0,.3);}
.prog-sec{padding-left:16px;border-left:1px solid var(--border);min-width:200px;}
.prog-lbl{font-size:10px;color:var(--text2);letter-spacing:2px;text-transform:uppercase;margin-bottom:6px;}
.prog-nums{font-family:var(--orb);font-size:22px;color:var(--cyan);}
.prog-sub{font-size:11px;color:var(--text3);margin-top:1px;}
.prog-bar{height:5px;background:rgba(0,212,255,.1);border-radius:3px;overflow:hidden;margin-top:8px;}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--cyan),rgba(0,212,255,.6));border-radius:3px;transition:width .6s;box-shadow:0 0 8px rgba(0,212,255,.5);width:0%;}
.btn-row{display:flex;gap:10px;align-items:center;padding:10px 20px;border-top:1px solid var(--border);}
.btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--body);font-size:13px;font-weight:600;padding:9px 20px;border-radius:6px;border:1px solid;cursor:pointer;transition:all .2s;background:transparent;letter-spacing:.5px;}
.btn:active{transform:scale(.97);}
.btn-start{color:var(--green);border-color:var(--green);background:rgba(0,230,118,.08);}
.btn-start:hover{background:rgba(0,230,118,.18);box-shadow:0 0 16px rgba(0,230,118,.3);}
.btn-stop{color:var(--amber);border-color:var(--amber);background:rgba(255,171,0,.08);}
.btn-stop:hover{background:rgba(255,171,0,.18);box-shadow:0 0 16px rgba(255,171,0,.3);}

/* STAT CARDS */
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:14px;}
.sc{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:16px;position:relative;overflow:hidden;}
.sc::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
.sc.cc::before{background:var(--cyan);box-shadow:0 0 8px var(--cyan);}
.sc.cg::before{background:var(--green);box-shadow:0 0 8px var(--green);}
.sc.ca::before{background:var(--amber);box-shadow:0 0 8px var(--amber);}
.sc.cr::before{background:var(--red);box-shadow:0 0 8px var(--red);}
